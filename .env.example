# Copie ce fichier en `.env` et remplis tes valeurs réelles.
# ⚠️ Ne commit JAMAIS le fichier .env (il est déjà dans .gitignore).

# 1) Va sur https://my.telegram.org → API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# 2) Crée un bot via @BotFather et colle le token ici
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# 3) Optionnel : id du channel pour le force-subscribe (ex: -1001234567890)
# CHANNEL=

# 4) Optionnel : chemin d'un ffmpeg hors PATH
# FFMPEG_LOCATION=/usr/bin/ffmpeg

# 5) Optionnel : bloquer les utilisateurs si le force-sub est mal configuré
# FORCE_SUB_STRICT=true

# 6) Optionnel : proxy (déblocage YouTube dans certains pays)
# HTTP_PROXY=http://user:pass@host:port
